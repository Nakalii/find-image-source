{
  "manifest_version": 3,
  "name": "找图出处 · Find Image Source",
  "version": "0.13.0",
  "description": "右键任意图片/视频帧，在侧边栏并排查看 SauceNAO / TraceMoe / Google Lens / ascii2d / Yandex 的搜图结果。",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ascii2d.net/*"
      ],
      "js": [
        "ascii2d-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "selftest.html",
    "open_in_tab": true
  },
  "commands": {
    "capture-video-frame": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "抓当前标签页视频的当前帧并找它的出处（播放器接管右键时用；键位可在 edge://extensions/shortcuts 改）"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "找图出处",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
